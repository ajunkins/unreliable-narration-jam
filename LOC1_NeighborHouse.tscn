[node name="Prose1" parent="Panel" unique_id=250299459 instance=ExtResource("4_h6psl")]
visible = false
layout_mode = 0
text = "The neighbors left their house unlocked. You let yourself in without a sound. The air is cloying and stale."
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose2" parent="Panel" unique_id=2075636996 instance=ExtResource("4_h6psl")]
layout_mode = 0
text = "There's a few suitcases by the door, ready to go, but you didn't see a car in the driveway. The remains of dinner sit on the dining room table, uneaten. The fridge door hangs open - nothing edible in there, not by now - but the pantry looks unraided. A flight of stairs leads up and out of sight."
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose3" parent="Panel" unique_id=797699136 instance=ExtResource("4_h6psl")]
visible = false
layout_mode = 0
text = "You're thankful there's enough windows to see comfortably, but that means anyone outside can see you. Better work quick."
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose4" parent="Panel" unique_id=1568034569 instance=ExtResource("4_h6psl")]
visible = false
layout_mode = 0
text = "The neighbors didn't have much before they left, or maybe they took their nonperishables. It doesn't matter now. There's a few cans in here, and you put them in your backpack.
+2 SUPPLIES"
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose5" parent="Panel" unique_id=387295285 instance=ExtResource("4_h6psl")]
visible = false
layout_mode = 0
text = "The bedrooms have clothing scattered over the furniture and on the floor. In the master, a safe sits open, its contents spilled out before it. Bills, papers, jewelery. Plenty of value, nothing of use. "
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose6" parent="Panel" unique_id=1638802790 instance=ExtResource("4_h6psl")]
visible = false
layout_mode = 0
text = "From the second floor widow, you can see some locations of note:

The local gas station. There's a cluster of cars abandoned near the pumps. 
+LOC2_gas_station
A clinic down the street. The front windows are shattered, but it might still hold supplies. 
+LOC3_clinic"
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

