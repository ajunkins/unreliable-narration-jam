[node name="Prose1" parent="Panel" unique_id=250299459 instance=ExtResource("4_ijkhi")]
layout_mode = 0
text = "Mikey is long gone, one way or another. The apartment building at the address is burnt to the ground. The cinders are still smoking. A total bust."
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose2" parent="Panel" unique_id=1497699288 instance=ExtResource("4_ijkhi")]
visible = false
layout_mode = 0
text = "As you walk back home, you notice an alleyway off the road, or more accurately, you notice the blue hatchback parked in front of it. There's a tent past it, partially hidden behind a dumpster, and it looks untouched. "
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose3" parent="Panel" unique_id=911447540 instance=ExtResource("4_ijkhi")]
visible = false
layout_mode = 0
text = "The guidebook says to leave no stone unturned."
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose4" parent="Panel" unique_id=570361719 instance=ExtResource("4_ijkhi")]
visible = false
layout_mode = 0
text = "The driver's door opens without any complaint. You're not sure why the owners left it unlocked, but you're glad they did. Tucked in the foot space of the passenger seat, you find a backpack stuffed with canned food.

+3 SUPPLIES"
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose5" parent="Panel" unique_id=204693647 instance=ExtResource("4_ijkhi")]
visible = false
layout_mode = 0
text = "There's someone in the tent, huddled in the corner, clad in a thin hoodie and sweat pants. Facing away from you. They aren't moving at all."
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose6" parent="Panel" unique_id=701563294 instance=ExtResource("4_ijkhi")]
visible = false
layout_mode = 0
text = "You feel grateful their belongings are left near to the entrance: A handful of batteries, some packaged noodles, and a few bottles of water. "
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose7" parent="Panel" unique_id=898350316 instance=ExtResource("4_ijkhi")]
visible = false
layout_mode = 0
text = "A glitter of brass sitting on a sleeping bag catches your eye. You pocket the pistol rounds, but there isn't a weapon anywhere to be seen."
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose8" parent="Panel" unique_id=2092716257 instance=ExtResource("4_ijkhi")]
visible = false
layout_mode = 0
text = "You feel you've overstayed your welcome.

