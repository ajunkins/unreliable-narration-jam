[node name="Prose1" parent="Panel" unique_id=250299459 instance=ExtResource("3_snmgu")]
layout_mode = 0
text = "Two ambulances stand on the road outside the clinic. Their doors are left open, and you can clearly see the wadded bandages and stained gurneys within. One is still occupied, and judging from the smell, has been there a while. The heat isn't doing any good.

The clinic itself is smashed to pieces. You walk through the tall, wide windows, reduced to nothing more than a few shards in each frame, and the glass crunches under your boots. You grip your pistol tightly.

The building is dead silent, and dirty shoe prints smear the floor around the front desk, leading into darkened hallways. "
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

