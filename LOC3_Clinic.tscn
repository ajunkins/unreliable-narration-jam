[node name="Prose1" parent="Panel" unique_id=250299459 instance=ExtResource("4_drhwi")]
visible = false
layout_mode = 0
text = "Two ambulances stand on the road outside the clinic. Their doors are left open, and you can clearly see the wadded bandages and stained gurneys within. One is still occupied, and judging from the smell, has been there a while. The heat isn't doing any good."
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose2" parent="Panel" unique_id=1341343538 instance=ExtResource("4_drhwi")]
visible = false
layout_mode = 0
text = "The clinic itself is smashed to pieces. You walk through the tall, wide windows, reduced to nothing more than a few shards in each frame, and the glass crunches under your boots. You grip your pistol tightly."
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose3" parent="Panel" unique_id=383278121 instance=ExtResource("4_drhwi")]
visible = false
layout_mode = 0
text = "The building is dead silent, and dirty shoe prints smear the floor around the front desk, leading into darkened hallways. "
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

[node name="Prose4" parent="Panel" unique_id=1160728700 instance=ExtResource("4_drhwi")]
visible = false
layout_mode = 0
text = "Patient forms and unopened mail stuffs the drawers behind the receptionist's desk. You're about to write it off, when you notice a slip of paper left on the chair. It has an address, and scribbled underneath:

'MIKEY'S PLACE WILL BE SAFE. MEET THERE SOON. -KELLY'"
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
