[node name="InsideBldg" parent="InsideBldg/Panel2" unique_id=1662597028 instance=ExtResource("8_slfo7")]
layout_mode = 0
offset_left = 23.0
offset_right = 1097.0
text = "Most of the shelves here are barren, but people left a few things. You find a few bags of junk food knocked to the floor behind the register, and a plastic water bottle forgotten in the floor of one of the fridges.

You pack up your backpack and turn to exit, but a figure blocks your path. His jacket is torn, his shirt is fithy, and his jeans are ripped to shreds. A dirty beard hides half of his face, and his eyes are wide and wild. You can smell him from across the room.

A machete hangs from his right hand. You raise your revolver."
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

