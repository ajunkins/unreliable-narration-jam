[node name="Intro" parent="Intro/Panel" unique_id=250299459 instance=ExtResource("8_slfo7")]
layout_mode = 0
offset_top = 20.0
offset_bottom = 200.0
text = "The cars jamming up the road and the space around the pumps hide the 'NO MORE GAS' sign hastily written in thick, smeared streaks of red paint on plywood. Minivans, trucks, sedans and SUVs are left abandoned, doors hanging open, windows smashed. Belongings are scattered on the gasoline-stained asphalt in between the tires. In one of the cars, you find a printed out map of the city.

The service building seems intact, but it's difficult to see inside with the lights off. Your revolver is heavy in your hand as you stand before jammed-open sliding glass doors.

"
autowrap_mode = 3
metadata/SetAsOverrideLabel = ""
metadata/ShowOnVar = ""
metadata/HideOnVar = ""

